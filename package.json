{
  "name": "finance-with-kunal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "prebuild": "npm run fetch:india-cpi -- --allow-cached",
    "postbuild": "node src/lib/postbuild-og.mjs && node src/lib/postbuild-security.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs src/lib/*.test.mjs",
    "audit:security": "npm audit --audit-level=high",
    "fetch:yahoo": "./.venv/bin/python3 src/lib/fetch-yahoo.py",
    "fetch:yahoo:setup": "python3 -m venv .venv && ./.venv/bin/python3 -m pip install --upgrade pip && ./.venv/bin/python3 -m pip install -r requirements.txt",
    "fetch:bonds": "node src/lib/fetch-bonds.mjs",
    "fetch:fred": "node src/lib/fetch-fred.mjs",
    "fetch:opec": "node src/lib/fetch-opec.mjs",
    "fetch:boc": "node src/lib/fetch-boc.mjs",
    "fetch:statcan": "node src/lib/fetch-statcan.mjs",
    "fetch:eurostat": "node src/lib/fetch-eurostat.mjs",
    "fetch:india-cpi": "python3 src/lib/fetch-india-cpi.py",
    "fetch:twelvedata": "node src/lib/fetch-twelvedata.mjs",
    "fetch:finnhub": "node src/lib/fetch-finnhub.mjs",
    "build:catalogue": "./.venv/bin/python3 src/lib/build-catalogue.py",
    "fetch:sectors": "./.venv/bin/python3 src/lib/fetch-sectors.py",
    "fetch:heatmap": "./.venv/bin/python3 src/lib/fetch-heatmap.py",
    "patch:heatmap": "./.venv/bin/python3 src/lib/patch-heatmap.py",
    "fetch:ai": "./.venv/bin/python3 src/lib/fetch-yahoo.py --only=ai",
    "patch:ai": "node src/lib/patch-ai-stocks.mjs",
    "gen:ticker-names": "./.venv/bin/python3 src/lib/gen-ticker-names.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.65.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
